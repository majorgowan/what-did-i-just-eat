<div>
    <form action="/" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="textareawrapper">
            <textarea class="main-input" name="text" id="dictated_text" rows="6" cols="50"
             placeholder="Describe your meal in detail in natural language"><%- (locals.rawText) ? rawText : "" %></textarea>
        </div>
        <button type="submit">Submit</button>
    </form>
</div>
